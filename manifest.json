{
  "manifest_version": 3,
  "name": "NightShift",
  "version": "0.4.1",
  "description": "A free, persistent dark mode for the web. Reduce eye strain on every site.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NightShift — toggle dark mode",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content/darkmode.css"
      ],
      "js": [
        "content/darkmode.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "toggle-global": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle NightShift dark mode on or off"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle dark mode for the current site"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nightshift@nightshift.local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
