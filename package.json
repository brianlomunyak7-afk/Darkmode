{
  "name": "nightshift",
  "version": "0.2.0",
  "description": "A free, persistent dark mode for the web. Reduce eye strain on every site.",
  "private": true,
  "scripts": {
    "icons": "python3 scripts/make_icons.py",
    "validate": "node tests/validate.test.js",
    "test": "node --test",
    "package": "bash scripts/package.sh",
    "build": "npm run icons && npm run validate && npm run package",
    "serve": "node scripts/serve.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
